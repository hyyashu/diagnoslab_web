----OLD
# Database
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE

FRONTEND_URL=https://diagnoslab.in

# Frontend URLs (for CORS)
ADMIN_FRONTEND_URL=http://localhost:5173
USER_FRONTEND_URL=http://localhost:3001


SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_ENCRYPTION=ssl
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=true
SMTP_FROM_NAME=
MAIL_FROM=
JWT_SECRET=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Web push for the staff dashboard. Generate once: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:info@diagnoslab.in

# Google Ads conversions sheet (bookings -> Google Ads), through the sheet's
# Apps Script web app (apps/api/google-apps-script/AdsConversions.gs).
# Leave empty to turn off. The secret must match SECRET in the script's
# Script properties.
GOOGLE_SHEET_WEBHOOK_URL=
GOOGLE_SHEET_WEBHOOK_SECRET=
GOOGLE_ADS_CONVERSION_NAME=Booked Patient
