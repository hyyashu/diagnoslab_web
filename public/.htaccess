# Diagnos Lab — static export served by LiteSpeed (Apache-compatible).
# `next build` copies this file from public/ into out/.
#
# The host already forces https, strips www and adds trailing slashes. The
# https/www rules below repeat that so the site stays correct if this file
# replaces an existing one on the server; when the host has already
# redirected, their conditions don't match and they do nothing.

ErrorDocument 404 /404.html

# Something outside public_html (not in hPanel's Redirects list; most likely
# a parent-folder .htaccess) sends exactly /book-a-test to the home page,
# which is the URL Google has indexed for this page. A matching rule here
# takes precedence, so /book-a-test goes to /book-a-test/ like every other
# page. Verified against a simulated parent RedirectMatch/Redirect in Apache.
RedirectMatch 301 ^/book-a-test$ https://diagnoslab.in/book-a-test/

# Caching. Every .js/.css/.woff2 is a Next build file under /_next/static
# whose name changes with its content, so it can be cached for a year.
# Images keep their names across deploys, so they get 30 days. HTML, the
# RSC .txt payloads and sitemaps keep their names but change on every
# deploy, so browsers revalidate them.
<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(avif|webp|png|jpe?g|svg|ico)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
  <FilesMatch "\.(html|txt|xml)$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On

  # http -> https (X-Forwarded-Proto guard avoids a loop behind a proxy/CDN)
  RewriteCond %{HTTPS} off
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^ https://diagnoslab.in%{REQUEST_URI} [R=301,L]

  # www -> apex
  RewriteCond %{HTTP_HOST} ^www\.diagnoslab\.in$ [NC]
  RewriteRule ^ https://diagnoslab.in%{REQUEST_URI} [R=301,L]

  # URLs from the previous site that Google still has indexed.
  RewriteRule ^about-us/?$ /aboutUs/ [R=301,L]
  RewriteRule ^corporate-tieups/?$ /corporate/ [R=301,L]
  RewriteRule ^center-locator/?$ /contact-us/ [R=301,L]
</IfModule>
