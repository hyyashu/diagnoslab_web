{
  "name": "diagnoslab",
  "private": true,
  "packageManager": "pnpm@10.15.0",
  "scripts": {
    "dev": "pnpm --filter @diagno/website dev",
    "build": "pnpm --filter @diagno/website build",
    "lint": "pnpm --filter @diagno/website lint",
    "deploy:website": "pnpm build && bash apps/website/delopy.sh",
    "build:packages": "pnpm --filter @diagno/schemas build && pnpm --filter @diagno/db build",
    "dev:api": "pnpm build:packages && pnpm --filter @diagno/api start:dev",
    "build:api": "pnpm build:packages && pnpm --filter @diagno/api build",
    "dev:admin": "pnpm --filter diagnosadmin dev",
    "build:admin": "pnpm --filter diagnosadmin build",
    "dev:mobile": "pnpm --filter @diagno/mobile start",
    "deploy:admin": "pnpm build:admin && bash apps/admin/deploy.sh"
  }
}
